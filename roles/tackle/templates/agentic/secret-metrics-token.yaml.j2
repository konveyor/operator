apiVersion: v1
kind: Secret
metadata:
  name: "{{ agentic_component_name }}-metrics-token"
  namespace: "{{ app_namespace }}"
  labels:
    app.kubernetes.io/name: "{{ agentic_component_name }}-metrics"
    app.kubernetes.io/component: "{{ agentic_component_name }}"
    app.kubernetes.io/part-of: "{{ app_name }}"
  annotations:
    # Helm/OLM installs this reader in the operator's installation namespace,
    # independently of agentic_component_name. app_namespace must match it:
    # a token Secret can only reference a ServiceAccount in its own namespace.
    kubernetes.io/service-account.name: agentic-controller-metrics-reader
type: kubernetes.io/service-account-token
