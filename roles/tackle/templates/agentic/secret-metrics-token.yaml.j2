# Synced to the operator by hack/sync-operator.sh; edit the source here.
apiVersion: v1
kind: Secret
metadata:
  name: "{{ agentic_component_name }}-metrics-token"
  # Must match the operator's installation namespace, where Helm/OLM
  # creates the reader ServiceAccount. If the reader is absent here,
  # Kubernetes deletes this token Secret and metrics scraping fails.
  namespace: "{{ app_namespace }}"
  labels:
    app.kubernetes.io/name: "{{ agentic_component_name }}-metrics"
    app.kubernetes.io/component: "{{ agentic_component_name }}"
    app.kubernetes.io/part-of: "{{ app_name }}"
  annotations:
    # Fixed Helm/OLM RBAC identity, independent of the per-Tackle
    # agentic_component_name used by the operand resources.
    kubernetes.io/service-account.name: agentic-controller-metrics-reader
type: kubernetes.io/service-account-token
