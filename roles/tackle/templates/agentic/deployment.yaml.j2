---
# Synced from konveyor/agentic-controller config/operator/deployment.yaml.j2 by
# hack/sync-operator.sh. Do not hand-edit in the operator -- update it here and
# re-sync.
#
# This is the operator's rendering of the controller Deployment: the container
# spec mirrors config/manager/manager.yaml (command, args, env, ports, probes,
# securityContext, default resources). Operator-specific values include the
# image ({{ agentic_fqin }}, resolved to a digest at bundle time), the
# name/namespace/labels, ServiceAccount, metrics certificate mount, and
# default-container annotation. Resource requests and limits are configurable
# through the operator role defaults and Tackle CR. Keep the default container
# spec in step with config/manager/manager.yaml when either changes;
# internal/manifests/deployment_parity_test.go fails the build if they drift.
apiVersion: apps/v1
kind: Deployment
metadata:
  name: {{ agentic_component_name }}
  namespace: "{{ app_namespace }}"
  labels:
    app.kubernetes.io/name: {{ agentic_component_name }}
    app.kubernetes.io/component: {{ agentic_component_name }}
    app.kubernetes.io/part-of: {{ app_name }}
spec:
  replicas: 1
  selector:
    matchLabels:
      app.kubernetes.io/name: {{ agentic_component_name }}
      app.kubernetes.io/component: {{ agentic_component_name }}
      app.kubernetes.io/part-of: {{ app_name }}
  template:
    metadata:
      annotations:
        kubectl.kubernetes.io/default-container: manager
      labels:
        app.kubernetes.io/name: {{ agentic_component_name }}
        app.kubernetes.io/component: {{ agentic_component_name }}
        app.kubernetes.io/part-of: {{ app_name }}
    spec:
      serviceAccountName: {{ agentic_component_name }}
      securityContext:
        runAsNonRoot: true
        seccompProfile:
          type: RuntimeDefault
      containers:
        - name: manager
          image: "{{ agentic_fqin }}"
          command:
            - /manager
          args:
            - --leader-elect
            - --health-probe-bind-address=:8081
            - --metrics-bind-address={{ agentic_metrics_bind_address }}
            - --metrics-cert-path=/etc/metrics-certs
            - --pprof-bind-address={{ agentic_pprof_bind_address }}
            - --memory-log-interval={{ agentic_memory_log_interval }}
          env:
            # The skill loader and the enumeration Job run this same image. The
            # controller cannot read its own image (it deliberately lacks
            # `pods get`), so SKILL_LOADER_IMAGE must be set explicitly and kept
            # equal to the image above (kustomize kept them in sync upstream).
            - name: SKILL_LOADER_IMAGE
              value: "{{ agentic_fqin }}"
          ports:
            - containerPort: 8081
              name: health
              protocol: TCP
            - containerPort: 8443
              name: https
              protocol: TCP
          securityContext:
            readOnlyRootFilesystem: true
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - "ALL"
          livenessProbe:
            httpGet:
              path: /healthz
              port: 8081
            initialDelaySeconds: 15
            periodSeconds: 20
          readinessProbe:
            httpGet:
              path: /readyz
              port: 8081
            initialDelaySeconds: 5
            periodSeconds: 10
          volumeMounts:
            - name: metrics-certs
              mountPath: /etc/metrics-certs
              readOnly: true
          resources:
            limits:
              cpu: "{{ agentic_container_limits_cpu }}"
              memory: "{{ agentic_container_limits_memory }}"
            requests:
              cpu: "{{ agentic_container_requests_cpu }}"
              memory: "{{ agentic_container_requests_memory }}"
      volumes:
        - name: metrics-certs
          secret:
            secretName: "{{ agentic_component_name }}-metrics-tls"
            # On OpenShift with metrics enabled, kubelet holds the pod in
            # ContainerCreating until service-ca creates this required Secret.
            optional: {{ (not (openshift_cluster | bool and agentic_metrics_enabled | bool)) | lower }}
      terminationGracePeriodSeconds: 10
