---
kind: NetworkPolicy
apiVersion: networking.k8s.io/v1
metadata:
  name: {{ app_name }}-namespace
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
spec:
  podSelector: {}
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ app_namespace }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ app_name }}-external
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
spec:
  podSelector:
    matchLabels:
      role: {{ ui_service_name }}
  ingress:
  - ports:
    - port: 8080
    - port: 8443
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ app_name }}-metrics
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
spec:
  podSelector:
    matchLabels:
      role: {{ hub_service_name }}
  ingress:
  - from:
    - namespaceSelector:
        matchLabels:
          network.openshift.io/policy-group: monitoring
  - ports:
    - port: {{ hub_metrics_port }}
---
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ app_name }}-egress
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
spec:
  podSelector: {}
  policyTypes:
  - Egress
  egress:
  # Cluster DNS resolution (all operands resolve *.svc names).
  - ports:
    - protocol: UDP
      port: 53
    - protocol: TCP
      port: 53
  # Intra-namespace traffic (ui<->hub, hub->kai/llm-proxy, kai-api->kai-db, etc.).
  - to:
    - namespaceSelector:
        matchLabels:
          kubernetes.io/metadata.name: {{ app_namespace }}
  # Outbound web + Kubernetes API server. 443/80 cover analyzer package-repo
  # pulls and external LLM providers; 443/6443 cover the host-networked API server.
  - ports:
    - protocol: TCP
      port: 443
    - protocol: TCP
      port: 80
    - protocol: TCP
      port: 6443
---
# Default-deny MUST be applied last: the operator reconciles these policies
# sequentially, so the allow rules above must already exist before ingress and
# egress are denied. Applying this first would sever the operator's own
# connection to the API server before the egress allow-list is created,
# deadlocking reconciliation.
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ app_name }}-deny-all
  namespace: {{ app_namespace }}
  labels:
    app: {{ app_name }}
spec:
  podSelector: {}
  policyTypes:
  - Ingress
  - Egress
